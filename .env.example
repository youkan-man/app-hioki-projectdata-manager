HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=8080
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=8443

# Address that Windows clients use to reach this Linux host. The HTTPS helper
# uses this value for the certificate CN and IP SAN.
PUBLIC_IP=
PUBLIC_DNS_NAMES=localhost

POSTGRES_DB=projectdata
POSTGRES_USER=projectdata
POSTGRES_PASSWORD=change-this-on-a-shared-network

# Keep the default named volume, or set an absolute Windows path such as
# D:/HiokiProjectArchives. Prefer compose.storage.example.yaml for a bind mount.
ARCHIVE_STORAGE=project_archives
REBUILD_INDEX_ON_STARTUP=false

# HTTPS certificate paths are resolved from the repository directory.
TLS_CERT_FILE=./.certs/tls.crt
TLS_KEY_FILE=./.certs/tls.key
